<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="login-root" prefWidth="1180" prefHeight="760">
    <HBox>
        <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="edge-to-edge" style="-fx-background-color: transparent;" minWidth="320" prefWidth="540">
            <VBox fx:id="brandPane" styleClass="login-brand" spacing="16" alignment="CENTER_LEFT" minWidth="300">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <ImageView fx:id="logoView" fitWidth="74" fitHeight="74" preserveRatio="true"/>
                    <VBox spacing="2">
                        <Label text="MUBARAK" styleClass="sidebar-brand" style="-fx-font-size: 23px;"/>
                        <Label text="CAFE &amp; RESTAURANT" styleClass="sidebar-brand-sub" style="-fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Region prefHeight="16"/>
                <Label text="Crafted for great food&#10;and effortless service." styleClass="login-brand-title" wrapText="true"/>
                <Label text="A refined all-in-one workspace for orders, tables, kitchen, stock, cash and reporting. Designed to keep your cafe running beautifully, even offline."
                       styleClass="login-brand-sub" wrapText="true" maxWidth="430"/>

                <Region prefHeight="10"/>
                <HBox spacing="11" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-check-circle" iconSize="14"/>
                    <Label text="Offline-first SQLite storage with verified backups" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="11" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-check-circle" iconSize="14"/>
                    <Label text="Role-based access, audit history and cash controls" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="11" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-check-circle" iconSize="14"/>
                    <Label text="Interactive floor plans, kitchen display and dual receipts" styleClass="login-feature"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS" minHeight="16"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="offlineBadge" text="● LOCAL DATABASE · OFFLINE READY" styleClass="splash-badge"/>
                    <Label fx:id="versionLabel" text="v1.0.0" styleClass="sidebar-brand-sub"/>
                </HBox>
                <Label text="Data directory: C:\RestaurantPOS" fx:id="dataPathLabel" styleClass="sidebar-brand-sub"/>
            </VBox>
        </ScrollPane>

        <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="login-panel,edge-to-edge" minWidth="360" prefWidth="560">
            <StackPane alignment="CENTER">
                <VBox fx:id="loginCard" styleClass="login-card" spacing="13" alignment="CENTER_LEFT" maxWidth="460">
                    <Label text="Welcome back" styleClass="login-title"/>
                    <Label text="Sign in to open your workspace." styleClass="muted"/>

                    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" visible="false" managed="false"/>

                    <VBox spacing="6">
                        <Label text="USERNAME" styleClass="field-label"/>
                        <TextField fx:id="usernameField" promptText="name@restaurant.com" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="PASSWORD" styleClass="field-label"/>
                        <StackPane>
                            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="text-field"/>
                            <TextField fx:id="visiblePasswordField" promptText="Enter your password" styleClass="text-field"
                                       visible="false" managed="false"/>
                        </StackPane>
                    </VBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <CheckBox fx:id="showPasswordCheck" text="Show password"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="forgotLink" text="Forgot password?"/>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <CheckBox fx:id="rememberCheck" text="Remember my username"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Button fx:id="loginButton" text="Sign in" styleClass="primary-button" maxWidth="Infinity" prefHeight="42">
                        <graphic><FontIcon iconLiteral="fas-sign-in-alt" iconSize="14"/></graphic>
                    </Button>

                    <VBox styleClass="login-info" spacing="3">
                        <Label text="FIRST-TIME SETUP" styleClass="field-label"/>
                        <Label text="Initial accounts are created only when the database is new. The owner is required to set a new password after the first sign-in."
                               styleClass="muted" wrapText="true"/>
                    </VBox>

                    <Region prefHeight="2"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-shield-alt" iconSize="11" style="-fx-icon-color: #8d939e;"/>
                        <Label text="Passwords are hashed. Failed attempts are logged." styleClass="muted"/>
                    </HBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </HBox>
</StackPane>
